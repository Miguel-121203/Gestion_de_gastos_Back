pipeline {
    agent any

    environment {
        IMAGE_NAME = 'gestion-user-dev'
        IMAGE_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code...'
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                echo 'Building Spring Boot User Service...'
                dir('Back/ms_user') {
                    sh 'chmod +x ./mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                dir('Back/ms_user') {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                }
            }
        }

        stage('Deploy Application') {
            steps {
                echo 'Deploying User Service...'
                sh '''
                    docker network create gestios-gastos-back-dev || true
                    
                    docker stop msuser-dev || true
                    docker rm msuser-dev || true

                    docker run -d \
                      --name msuser-dev \
                      --network gestios-gastos-back-dev \
                      -p 8202:8200 \
                      -e SPRING_PROFILES_ACTIVE=dev \
                      -e SPRING_DATASOURCE_URL="jdbc:postgresql://DataBase-dev:5432/gestion_gastos_dev" \
                      -e SPRING_DATASOURCE_USERNAME=postgres \
                      -e SPRING_DATASOURCE_PASSWORD=dev123456 \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                    
                    sleep 10
                    if docker ps | grep msuser-dev; then
                        echo "✅ User Service running on port 8202"
                    else
                        echo "❌ Failed to start User Service"
                        docker logs msuser-dev || true
                        exit 1
                    fi
                '''
            }
        }
    }

    post {
        always {
            echo '✅ Pipeline completed'
        }
    }
}