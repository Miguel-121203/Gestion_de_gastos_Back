pipeline {
    agent any

    environment {
        IMAGE_NAME = 'gestion-user-pdn'
        IMAGE_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code...'
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                echo 'Building Spring Boot User Service PDN...'
                dir('Back/ms_user') {
                    sh 'chmod +x ./mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                dir('Back/ms_user') {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                }
            }
        }

        stage('Deploy Application') {
            steps {
                echo 'Deploying User Service PDN...'
                sh '''
                    docker network create gestios-gastos-back-pdn || true
                    
                    docker stop msuser-pdn || true
                    docker rm msuser-pdn || true

                    docker run -d \
                      --name msuser-pdn \
                      --network gestios-gastos-back-pdn \
                      -p 8200:8200 \
                      -e SPRING_PROFILES_ACTIVE=pdn \
                      -e SPRING_DATASOURCE_URL="jdbc:postgresql://DataBase-pdn:5432/gestion_gastos_pdn" \
                      -e SPRING_DATASOURCE_USERNAME=postgres \
                      -e SPRING_DATASOURCE_PASSWORD=pdn123456 \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                    
                    sleep 10
                    if docker ps | grep msuser-pdn; then
                        echo "✅ User Service PDN running on port 8200"
                    else
                        echo "❌ Failed to start User Service PDN"
                        docker logs msuser-pdn || true
                        exit 1
                    fi
                '''
            }
        }
    }

    post {
        always {
            echo '✅ Pipeline completed'
        }
    }
}